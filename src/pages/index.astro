---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Ayush Rameja" description="Ayush Rameja — software engineer." home>
  <section class="landing" aria-labelledby="hero-title">
    <div class="landing-copy" id="hero-copy"><h1 id="hero-title">Ayush Rameja</h1><p>Software engineer</p></div>
  </section>
</BaseLayout>
<style>
  .landing { min-height: 100svh; background: #050506; color: #f7f3ef; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; padding: 40px 24px; text-align: center; }
  .landing-copy h1 { font-size: clamp(28px, 5vw, 48px); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; margin: 0; }
  .landing-copy p { color: #a8a5aa; font-size: 14px; margin-top: 12px; }
</style>
