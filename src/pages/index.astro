---
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import "../styles/neutral-hero.css";
---
<!doctype html>
<html lang="en" class="home-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ayush Rameja</title>
    <meta name="description" content="Ayush Rameja — full-stack engineer in Bengaluru building useful digital products." />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Only hide the hero when JavaScript and motion are available. If the
      // animation bundle fails, the page still opens within seven seconds.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.dataset.intro = "pending";
        window.setTimeout(() => {
          if (document.documentElement.dataset.intro === "pending" && !document.documentElement.hasAttribute("data-intro-preview")) {
            delete document.documentElement.dataset.intro;
            window.dispatchEvent(new Event("intro:timeout"));
          }
        }, 6500);
      }
    </script>
  </head>
  <body>
    <main id="hero" tabindex="-1"><Hero /></main>
  </body>
</html>
