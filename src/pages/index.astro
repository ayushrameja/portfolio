---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectMosaic from "../components/ProjectMosaic.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import BottomNav from "../components/BottomNav.astro";
import "lenis/dist/lenis.css";
---
<BaseLayout title="Ayush Rameja" description="Ayush Rameja — full-stack engineer in Bengaluru building useful digital products. Explore selected work and notes on software engineering." home>
  <Hero />
  <ProjectMosaic />
  <ExperienceSection />
  <BottomNav />
</BaseLayout>

<style>
  :global(.home-main) { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
</style>

<script>
  import { setupHomeScroll } from "../scripts/home-scroll";
  setupHomeScroll();
</script>
