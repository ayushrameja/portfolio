---
import { render } from "astro:content";
import { getProjects } from "../../lib/content";
import { projectClient, projectImages } from "../../data/project-presentation";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project-pages.css";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content, headings } = await render(project);
const images = projectImages[project.id] ?? [];
const sections = headings.filter(heading => heading.depth === 2);
const hasBody = Boolean(project.body?.trim());
const facts = [
  ["My role", project.data.role],
  ["Client", projectClient(project.data.client, project.data.employer)],
  ["Timeline", project.data.timeline],
  ["Status", project.data.status],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<BaseLayout title={`${project.data.title} · Ayush Rameja`} description={project.data.summary} project>
  <header class="project-intro">
    <nav class="project-breadcrumb" aria-label="Breadcrumb">
      <a href="/projects/">Projects</a><span aria-hidden="true">/</span>
      <span>{project.data.kind === "employer" ? "Employer work" : "Independent"}</span>
    </nav>
    <h1>{project.data.title}</h1>
    <p class="project-lead">{project.data.summary}</p>
    {(project.data.href || project.data.source) && <div class="project-actions">
      {project.data.href && <a class="project-button" href={project.data.href} target="_blank" rel="noopener noreferrer">Visit site<span class="sr-only"> (opens in a new tab)</span></a>}
      {project.data.source && <a class={project.data.href ? "project-text-link" : "project-button"} href={project.data.source} target="_blank" rel="noopener noreferrer">Source<span class="sr-only"> (opens in a new tab)</span></a>}
    </div>}
    {facts.length > 0 && <dl class="project-facts">
      {facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>}
  </header>

  {images.length > 0 && <div class:list={["project-gallery", { "project-gallery-pair": images.length > 1 }]}>
    {images.map((image, index) => <figure>
      <div class="project-image-surface"><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" /></div>
      <figcaption>{image.caption}</figcaption>
    </figure>)}
  </div>}

  {(hasBody || project.data.skills?.length) && <div class="project-story-layout">
    <aside class="project-story-aside">
      {sections.length > 0 && <nav class="project-contents" aria-label="On this page">
        <h2>In this project</h2>
        {sections.map(section => <a href={`#${section.slug}`}>{section.text}</a>)}
      </nav>}
      {project.data.skills && project.data.skills.length > 0 && <section aria-labelledby="tools-heading">
        <h2 id="tools-heading">Built with</h2>
        <ul class="project-tools">{project.data.skills.map(skill => <li>{skill}</li>)}</ul>
      </section>}
    </aside>
    {hasBody && <article class="project-story">
      {sections.length === 0 && <h2>The work</h2>}
      <Content />
      {project.data.kind === "employer" && <p class="project-source-note">Figures reflect the original project record.</p>}
    </article>}
  </div>}

  <nav class="project-next" aria-label="More projects">
    <a href="/projects/" class="project-text-link">All projects</a>
    <a href={`/projects/${next.id}/`} class="project-next-link"><span>Next project</span><strong>{next.data.title}</strong></a>
  </nav>
</BaseLayout>
