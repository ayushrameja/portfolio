---
import { getProjects } from "../../lib/content";
import { projectClient } from "../../data/project-presentation";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project-pages.css";

const projects = await getProjects();
const groups = [
  { id: "employer", label: "Employer work", description: "Engineering for Autodesk, Siemens and clients through Accenture." },
  { id: "independent", label: "Independent", description: "Games, websites and tools built from curiosity." },
] as const;
---

<BaseLayout title="Projects · Ayush Rameja" description="Explore Ayush Rameja's professional engineering work and independent projects, with contributions, outcomes and project details." project>
  <header class="project-intro project-index-intro">
    <h1>Work, in detail.</h1>
    <p class="project-lead">Professional engineering and independent projects, with the work behind each one.</p>
    <nav class="project-index-jumps" aria-label="Project categories">
      {groups.map(group => <a href={`#${group.id}-heading`}>{group.label}</a>)}
    </nav>
  </header>
  {groups.map(group => <section class="project-index-group" aria-labelledby={`${group.id}-heading`}>
    <header><h2 id={`${group.id}-heading`}>{group.label}</h2><p>{group.description}</p></header>
    <ul class="project-index-list">
      {projects.filter(project => project.data.kind === group.id).map(project => <li>
        <a class="project-index-entry" href={`/projects/${project.id}/`}>
          <div class="project-index-name"><h3>{project.data.title}</h3><p>{projectClient(project.data.client, project.data.employer) ?? project.data.status ?? project.data.role}</p></div>
          <p class="project-index-summary">{project.data.summary}</p>
          <span class="project-index-action">View project</span>
        </a>
      </li>)}
    </ul>
  </section>)}
</BaseLayout>
