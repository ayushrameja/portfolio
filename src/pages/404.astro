---
import BaseLayout from "../layouts/BaseLayout.astro";
import Panel from "../components/Panel.astro";
const arrowPath = "M2 8h12M8 2l6 6-6 6";
---
<BaseLayout title="Page not found · Ayush Rameja" description="That address is not on this site.">
  <Panel as="div" glow="coral" class="lost">
    <div class="panel-inner lost-inner">
      {/* The zero is a disc from the mark, looking for the page. */}
      <p class="lost-code" aria-hidden="true" data-reveal>
        <span>4</span>
        <span class="lost-zero shape shape-disc tone-coral" data-reveal="turn"><i class="lost-eye"></i><i class="lost-eye"></i></span>
        <span>4</span>
      </p>
      <h1 class="display" data-reveal="words">Page not found</h1>
      <p class="lead" data-reveal>That address is not on this site.</p>
      <p class="lost-actions" data-reveal>
        <a class="button" href="/">Back to home <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} /></svg></a>
        <a class="button-quiet" href="/projects/">See the work</a>
        <a class="button-quiet" href="/notes/">Read the notes</a>
      </p>
    </div>
  </Panel>
</BaseLayout>

<style>
  .lost { display:grid; place-items:center; min-height:calc(100svh - var(--gutter)*2 - 96px); }
  .lost-inner { display:grid; justify-items:center; gap:18px; text-align:center; }
  .lost-code { display:flex; align-items:center; gap:.06em; margin:0 0 8px; font-size:clamp(6rem,24vw,15rem); font-weight:500; line-height:.9; letter-spacing:-.05em; }
  .lost-zero { display:flex; align-items:center; justify-content:center; gap:.07em; width:.8em; height:.8em; }
  /* Eyes in the hero button's manner: the pupils search one way, then the other. */
  .lost-eye { position:relative; display:block; width:.17em; height:.19em; overflow:hidden; border-radius:50% 50% 46% 46%; background:radial-gradient(circle at 50% 38%,#fff,#ece7dd 68%,#cdc5b6); box-shadow:inset 0 .02em .02em rgb(24 12 70/.3); animation:lost-blink 5.2s infinite; }
  .lost-eye::after { content:""; position:absolute; left:50%; top:52%; width:54%; height:50%; border-radius:50%; background:radial-gradient(circle,#09090b 0 36%,#9a6a2f 40% 64%,#4a2c12 70%); translate:-50% -50%; animation:lost-search 5.2s var(--ease-out) infinite; }
  @keyframes lost-search { 0%,8% { translate:-50% -50%; } 14%,36% { translate:-88% -46%; } 44%,66% { translate:-12% -46%; } 74%,84% { translate:-50% -78%; } 92%,100% { translate:-50% -50%; } }
  @keyframes lost-blink { 0%,38%,42%,86%,90%,100% { scale:1 1; } 40%,88% { scale:1 .1; } }
  .lost-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin:14px 0 0; }
  @media(max-width:600px) { .lost-actions { flex-direction:column; width:100%; } .lost-actions a { width:100%; } }
  @media(prefers-reduced-motion:reduce) { .lost-eye,.lost-eye::after { animation:none; } }
</style>
