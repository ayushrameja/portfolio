---
import { render } from "astro:content";
import { getNotes } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const deskLabel = note.data.desk === "engineering" ? "Engineering" : "Life";
---

<BaseLayout title={`${note.data.title} · Ayush Rameja`} description={note.data.description}>
  <p class="text-sm text-[var(--muted)]">
    <a href="/notes/">Notes</a>
    <span aria-hidden="true"> · </span>
    {deskLabel}
  </p>
  <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{note.data.title}</h1>
  <p class="mt-3 text-sm text-[var(--muted)]">
    {note.data.publishedAt} · {note.data.readingTime}
  </p>
  <p class="mt-6 text-lg leading-relaxed">{note.data.description}</p>
  {
    note.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
        {note.data.tags.map((tag) => (
          <li class="border border-[var(--line)] px-2 py-1 text-sm text-[var(--muted)]">{tag}</li>
        ))}
      </ul>
    )
  }
  <article class="content mt-8 max-w-[65ch]">
    <Content />
  </article>
</BaseLayout>
