---
import { render } from "astro:content";
import { getNotes } from "../../lib/content";
import { noteDate } from "../../lib/note-presentation";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Panel from "../../components/Panel.astro";
import "../../styles/notes.css";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map(note => {
    // Neighbours come from the same desk, which is listed newest first.
    const desk = notes.filter(other => other.data.desk === note.data.desk);
    const at = desk.indexOf(note);
    return { params: { slug: note.id }, props: { note, newer: desk[at - 1], older: desk[at + 1] } };
  });
}

const { note, newer, older } = Astro.props;
const { Content, headings } = await render(note);
const sections = headings.filter(heading => heading.depth === 2);
const desk = note.data.desk === "engineering"
  ? { label: "Engineering", tile: "tone-lime q-tl" }
  : { label: "Life", tile: "tone-sky q-br" };
const deskHref = `/notes/#${note.data.desk}`;
const neighbours = [{ label: "Newer", note: newer }, { label: "Older", note: older }].flatMap(item => item.note ? [{ label: item.label, note: item.note }] : []);
const arrowPath = "M2 8h12M8 2l6 6-6 6";
---
<BaseLayout title={`${note.data.title} · Ayush Rameja`} description={note.data.description}>
  <Panel as="header" glow="lime" id="article-top" tabindex="-1">
    <div class="note-head">
      <span aria-hidden="true" data-reveal="turn"><i class:list={["shape notes-q note-head-tile", desk.tile]}></i></span>
      <nav class="breadcrumb" aria-label="Breadcrumb" data-reveal>
        <a href="/notes/">Notes</a>
        <span aria-hidden="true">/</span>
        <a href={deskHref}>{desk.label}</a>
      </nav>
      <h1 class="note-title" id="article-title" data-reveal="words">{note.data.title}</h1>
      <p class="lead" data-reveal>{note.data.description}</p>
      <p class="notes-meta" data-reveal>
        <time datetime={note.data.publishedAt}>{noteDate(note.data.publishedAt)}</time>
        <span>{note.data.readingTime} read</span>
      </p>
      {note.data.tags.length > 0 && <ul class="chip-list" aria-label="Tags" data-reveal>
        {note.data.tags.map(tag => <li class="chip">{tag}</li>)}
      </ul>}
    </div>
  </Panel>
  <Panel as="article" glow="lime" pattern={false} aria-labelledby="article-title">
    <div class="note-layout">
      {sections.length > 1 && <details class="note-outline" open>
        <summary>In this article <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg></summary>
        <nav aria-label="Article contents">
          <ol role="list">
            {sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
          </ol>
        </nav>
      </details>}
      {sections.length > 1 && <script is:inline>
        // The outline starts open for the wide layout, where it sits beside
        // the text. Above the text it would delay the essay, so it folds.
        (function () {
          var outline = document.querySelector(".note-outline");
          if (outline && !window.matchMedia("(min-width: 1360px)").matches) outline.open = false;
        })();
      </script>}
      <div class="prose note-body">
        <Content />
        <div class="note-fin" aria-hidden="true">
          <i class="shape tone-lime notes-q q-tl"></i>
          <i class="shape tone-sky shape-disc"></i>
          <i class="shape tone-lime notes-q q-br"></i>
        </div>
      </div>
    </div>
  </Panel>
  <Panel as="div" glow="lime" pattern={false}>
    <nav class="panel-inner note-end" aria-label="Article navigation">
      {neighbours.length > 0 && <div class="note-end-grid" data-reveal>
        {neighbours.map(item => <a class="card note-end-card notes-link" href={`/notes/${item.note.id}/`}>
          <span class="fn-card-top">
            <span class="notes-meta"><span>{item.label}</span><span>{desk.label}</span></span>
            <span class:list={["shape notes-q notes-go", desk.tile]} aria-hidden="true"><svg viewBox="0 0 16 16"><path d={arrowPath} /></svg></span>
          </span>
          <span class="subheading notes-title">{item.note.data.title}</span>
          <span class="notes-meta"><time datetime={item.note.data.publishedAt}>{noteDate(item.note.data.publishedAt)}</time><span>{item.note.data.readingTime} read</span></span>
        </a>)}
      </div>}
      <p class="note-end-links" data-reveal>
        <a class="button-quiet" href={deskHref}>More {desk.label.toLowerCase()} notes <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} /></svg></a>
        <a class="text-link" href="#article-top">Back to top</a>
      </p>
    </nav>
  </Panel>
</BaseLayout>
<script>
  // Marks the section being read in the outline. The observer wakes when a
  // heading crosses the reading line, so nothing runs while scrolling between them.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".note-outline a"));
  if (links.length && "IntersectionObserver" in window) {
    const heads = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const mark = () => {
      let current = -1;
      heads.forEach((head, index) => { if (head && head.getBoundingClientRect().top < window.innerHeight * .4) current = index; });
      links.forEach((link, index) => index === current ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current"));
    };
    const observer = new IntersectionObserver(mark, { rootMargin: "0px 0px -60% 0px", threshold: [0, 1] });
    heads.forEach(head => head && observer.observe(head));
    // A jump can carry several headings past the line without any of them crossing it.
    window.addEventListener("scrollend", mark);
    mark();
  }
</script>
