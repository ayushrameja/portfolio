---
import { getEntry } from "astro:content";
import { noteDate } from "../lib/note-presentation";
import "../styles/field-notes.css";

const [featured, review, life] = await Promise.all([
  getEntry("notes", "how-to-review-agent-written-prs"),
  getEntry("notes", "code-review-comments-that-actually-help"),
  getEntry("notes", "gita-detachment-vs-apathy"),
]);
if (!featured || !review || !life) throw new Error("A curated Field Notes essay is missing from the notes collection.");
const deskLabel = (desk: string) => desk === "engineering" ? "Engineering" : "Life";
---
<section class="field-notes" id="notes" data-nav-section="Notes" tabindex="-1" aria-labelledby="notes-title">
  <header class="fn-section-heading">
    <div><h2 id="notes-title">Field notes.</h2><p class="fn-intro">On building software and figuring out the rest.</p></div>
    <a class="fn-archive-link" href="/notes/">All notes</a>
  </header>
  <div class="fn-stories">
    <article class="fn-featured">
      <a class="fn-story-link" href={`/notes/${featured.id}/`} aria-labelledby="featured-title">
        <h3 id="featured-title">{featured.data.title}</h3>
        <div class="fn-meta"><span>{deskLabel(featured.data.desk)}</span><time datetime={featured.data.publishedAt}>{noteDate(featured.data.publishedAt)}</time><span>{featured.data.readingTime} read</span></div>
        <div class="fn-reading-sample">
          <blockquote>Someone still has to decide whether the diff is <mark>correct, safe, maintainable, and worth shipping.</mark></blockquote>
          <div class="fn-margin-note" aria-hidden="true"><svg viewBox="0 0 40 32" fill="none"><path d="M34 28C12 28 8 18 10 5m-6 7 6-8 6 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>The part we can’t automate away.</span></div>
        </div>
        <span class="fn-read-story"><span>Read the essay</span></span>
      </a>
    </article>
    <div class="fn-secondary-stories">
      <article class="fn-supporting">
        <a class="fn-story-link" href={`/notes/${review.id}/`} aria-labelledby="review-title">
          <h3 id="review-title">{review.data.title}</h3>
          <div class="fn-meta"><span>{deskLabel(review.data.desk)}</span><span>{review.data.readingTime} read</span></div>
          <p>{review.data.description}</p>
        </a>
      </article>
      <article class="fn-supporting">
        <a class="fn-story-link" href={`/notes/${life.id}/`} aria-labelledby="life-title">
          <h3 id="life-title">{life.data.title}</h3>
          <div class="fn-meta"><span>{deskLabel(life.data.desk)}</span><span>{life.data.readingTime} read</span></div>
          <p>{life.data.description}</p>
        </a>
      </article>
    </div>
  </div>
</section>
