---
import Panel from "./Panel.astro";
import { contact } from "../data/contact";
import "../styles/contact.css";

const arrowPath = "M2 8h12M8 2l6 6-6 6";
const links = [
  { label: "LinkedIn", href: contact.linkedin },
  { label: "GitHub", href: contact.github },
  { label: "View résumé", href: contact.resume },
];
---
<Panel id="contact" glow="coral" tabindex="-1" aria-labelledby="contact-title">
  <div class="panel-inner">
    <header class="section-head">
      <p class="eyebrow" data-reveal>Contact</p>
      <h2 id="contact-title" class="display" data-reveal="words">Let’s talk.</h2>
      <p class="lead" data-reveal>A product to build, a system to simplify, or a new opportunity.</p>
    </header>
    <div class="contact-grid">
      <div class="contact-direct">
        <div class="contact-mosaic">
          <div class="contact-email-cell" data-reveal="grow">
            <a class="contact-email shape tone-coral" href={`mailto:${contact.email}`}>
              <span class="contact-email-label">Email</span>
              <span class="contact-email-address">{contact.email}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} transform="rotate(-45 8 8)" /></svg>
            </a>
          </div>
          <span class="contact-tile" data-reveal="turn" aria-hidden="true"><i class="shape tone-sky shape-tr"></i></span>
          <span class="contact-tile" data-reveal="turn" aria-hidden="true"><i class="shape tone-violet shape-br"></i></span>
        </div>
        <p class="contact-place on-dark" data-reveal><span>Bengaluru, India <span class="sr-only">·</span> <span class="muted">UTC +05:30</span></span></p>
        <nav class="contact-links" aria-label="Contact links" data-reveal>
          {links.map(link => <a class="button-quiet" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only"> (opens in a new tab)</span> <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} transform="rotate(-45 8 8)" /></svg></a>)}
        </nav>
      </div>
      <form class="contact-form card" action="/api/contact/" method="post" aria-label="Send Ayush a message" data-reveal>
        <p class="contact-note">Tell me what you have in mind. All fields are required.</p>
        <div class="contact-row">
          <div class="contact-field">
            <label for="contact-name">Your name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" autocapitalize="words" required maxlength="100" aria-describedby="contact-name-error" />
            <p class="contact-error" id="contact-name-error"></p>
          </div>
          <div class="contact-field">
            <label for="contact-email">Email address</label>
            <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" required maxlength="254" aria-describedby="contact-email-error" />
            <p class="contact-error" id="contact-email-error"></p>
          </div>
        </div>
        <div class="contact-field contact-field-grow">
          <label for="contact-message">Your message</label>
          <textarea id="contact-message" name="message" rows="5" autocomplete="off" required maxlength="5000" aria-describedby="contact-message-error"></textarea>
          <p class="contact-error" id="contact-message-error"></p>
        </div>
        <div class="contact-send">
          <p class="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
          <button class="button contact-submit" type="submit"><span data-label>Send message</span> <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} /></svg></button>
        </div>
        <noscript><p class="contact-note contact-noscript">Submitting opens a confirmation page. You can also use the email link.</p></noscript>
      </form>
    </div>
  </div>
</Panel>
<script>
  import { setupContactForm } from "../scripts/contact-form";
  setupContactForm();
</script>
