---
import { contact } from "../data/contact";
import "../styles/contact-section.css";
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<section id="contact" class:list={["contact-section", { "contact-section-home": home }]} aria-labelledby="contact-title" data-nav-section={home ? "Contact" : undefined} tabindex="-1">
  <div class="contact-copy">
    <h2 id="contact-title">Let’s talk.</h2>
    <p class="contact-intro">A product to build, a system to simplify, or a new opportunity.</p>
    <a class="contact-email" href={`mailto:${contact.email}`}>{contact.email}</a>
    <div class="contact-details">
      <p>Bengaluru, India<br /><span>UTC +05:30</span></p>
      <nav class="contact-links" aria-label="Contact links">
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={contact.resume} target="_blank" rel="noopener noreferrer">View résumé<span class="sr-only"> (opens in a new tab)</span></a>
      </nav>
    </div>
  </div>
  <form class="contact-form" action="/api/contact" method="post" aria-label="Send Ayush a message">
    <p class="contact-form-note">Tell me what you have in mind. All fields are required.</p>
    <div class="contact-field-row">
      <div class="contact-field">
        <label for="contact-name">Your name</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required aria-required="true" maxlength="100" aria-describedby="contact-name-error" />
        <p class="contact-field-error" id="contact-name-error"></p>
      </div>
      <div class="contact-field">
        <label for="contact-email">Email address</label>
        <input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required aria-required="true" maxlength="254" aria-describedby="contact-email-error" />
        <p class="contact-field-error" id="contact-email-error"></p>
      </div>
    </div>
    <div class="contact-field">
      <label for="contact-message">Your message</label>
      <textarea id="contact-message" name="message" rows="5" autocomplete="off" required aria-required="true" maxlength="5000" aria-describedby="contact-message-error"></textarea>
      <p class="contact-field-error" id="contact-message-error"></p>
    </div>
    <div class="contact-submit-row">
      <p class="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <button class="contact-submit" type="submit">Send message</button>
    </div>
    <noscript><p class="contact-form-note">Submitting opens a confirmation page. You can also use the email link.</p></noscript>
  </form>
</section>
<script>
  import { setupContactForm } from "../scripts/contact-form";
  setupContactForm();
</script>
