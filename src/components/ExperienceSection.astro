---
import { experiences } from "../data/experience";
import CompanyMark from "./CompanyMark.astro";
import "../styles/experience.css";
import "../styles/experience-index.css";
---
<section class="experience-section" id="experience" data-nav-section="Experience" tabindex="-1" aria-labelledby="experience-title">
  <header class="experience-heading">
    <h2 id="experience-title">Good teams.<br />Meaningful work.</h2>
    <p>My experience across learning platforms, industrial systems and enterprise software.</p>
  </header>
  <ol class="career-index">
    {experiences.map(experience => <li>
      <a class="career-entry" href={`/experience/${experience.id}/`} aria-labelledby={`experience-${experience.id}`}>
        <div class="career-employer"><CompanyMark company={experience.id} /><div><h3 id={`experience-${experience.id}`}>{experience.company}</h3><p>{experience.role}</p></div></div>
        <div class="career-overview"><p>{experience.title}</p><span>{experience.summary}</span></div>
        <div class="career-period"><span>{experience.start} to {experience.end}</span><span class="career-read">Explore chapter</span></div>
      </a>
    </li>)}
  </ol>
</section>
