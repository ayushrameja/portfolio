---
import { heroTiles } from "../brand/hero-tiles";
---
<div id="intro" class="intro" hidden tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="intro-title">
  <h2 id="intro-title" class="sr-only">Site introduction</h2>
  <div class="intro-backdrop" aria-hidden="true"></div>
  <div class="intro-white" aria-hidden="true"></div>
  <div class="intro-surface">
    <svg class="intro-logo" viewBox="-26 -4 157 58" role="img" aria-label="AR logo">
      {heroTiles.map((d, index) => <g class="intro-tile" data-index={index}><path d={d} fill-rule="evenodd" /></g>)}
    </svg>
  </div>
  <p class="intro-status" role="status" aria-live="polite">Loading page…</p>
</div>
<script>
  import { scheduleIntro, startIntro } from "../scripts/intro";
  scheduleIntro(import.meta.env.DEV ? new URLSearchParams(window.location.search).get("introDelay") : null, startIntro);
</script>
<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .intro { outline:none; position:fixed; inset:0; z-index:50; color:#f5f5ef; }
  .intro-backdrop,.intro-white { position:absolute; inset:0; pointer-events:none; }
  .intro-backdrop { background:#171a18; }
  .intro-white { background:#fafaf7; }
  .intro-surface { position:absolute; inset:0; display:grid; place-items:center; pointer-events:none; }
  .intro-logo { width:200px; max-width:60vw; fill:#f5f5ef; overflow:visible; opacity:0; }
  .intro-status { position:absolute; bottom:60px; width:100%; text-align:center; font-size:14px; opacity:0; }
  .intro[data-waiting] .intro-status { opacity:1; }
  @media(max-width:600px) { .intro-logo { width:170px; } }
</style>
