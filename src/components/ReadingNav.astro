---
import { heroTiles } from "../brand/hero-tiles";
import { contact } from "../data/contact";
import "../styles/bottom-nav.css";
import "../styles/reading-nav.css";

const path = Astro.url.pathname.replace(/\/$/, "");
const parent = path.startsWith("/projects/") ? { href: "/projects/", label: "All projects" }
  : path.startsWith("/notes/") ? { href: "/notes/", label: "All notes" }
  : path.startsWith("/experience/") ? { href: "/#experience", label: "All work" }
  : { href: "/#home", label: "Portfolio" };
---
<nav class="bottom-nav reading-nav" transition:name="bottom-nav" transition:animate="none" aria-label="Page navigation" data-visible="true" data-expanded="true" data-open="false">
  <div class="dock-bar">
    <a class="dock-logo" href="/#home" aria-label="Ayush Rameja, home">
      <svg viewBox="0 0 105 50" aria-hidden="true">{heroTiles.map(d => <path d={d} fill-rule="evenodd" />)}</svg>
    </a>
    <a class="dock-trigger reading-parent" href={parent.href}>{parent.label}</a>
    <a class="dock-resume" href={contact.resume} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)">Resume</a>
  </div>
</nav>
