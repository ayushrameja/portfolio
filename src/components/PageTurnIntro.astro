---
import BrandMark from "./BrandMark.astro";
import "../styles/page-turn-intro.css";

/** On the home page the intro sits in the hero frame and uncovers the hero.
 *  `standalone` gives other pages their own fixed frame over the viewport,
 *  with an invisible surface that sets the panel's shape and colours. */
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
---
{standalone ? (
  <div class="page-turn-frame">
    <div class="page-turn-surface" aria-hidden="true"></div>
    <div class="page-turn-intro" data-page-turn-intro aria-label="Site introduction">
      <div class="page-turn-intro__art" aria-hidden="true"><BrandMark class="page-turn-intro__mark" /></div>
      <canvas class="page-turn-intro__canvas" aria-hidden="true"></canvas>
    </div>
  </div>
) : (
  <div class="page-turn-intro" data-page-turn-intro aria-label="Site introduction">
    <div class="page-turn-intro__art" aria-hidden="true"><BrandMark class="page-turn-intro__mark" /></div>
    <canvas class="page-turn-intro__canvas" aria-hidden="true"></canvas>
  </div>
)}
<script>
  import { startPageTurnIntro } from "../scripts/page-turn-intro";
  startPageTurnIntro();
</script>
