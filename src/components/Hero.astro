---
import { Image } from "astro:assets";
import { heroTiles } from "../brand/hero-tiles";
import portrait from "../assets/portrait-approved.png";
const resume = "https://drive.google.com/file/d/1KH4dnH50ocYFxv0Cut7gqMltRDHgC088/preview";
const links = [
  { label: "Work", href: "/projects/" },
  { label: "Notes", href: "/notes/" },
  { label: "Resume", href: resume },
  { label: "Contact", href: "mailto:ayushrameja@gmail.com" },
];
---
<div class="hero-frame"><section class="hero" aria-labelledby="hero-title">
  <header class="hero-header">
    <time id="hero-clock" class="hero-clock" aria-label="Local time in Bengaluru"><span class="clock-day" id="clock-day"></span><span id="clock-time">India · IST</span></time>
    <a class="hero-logo" href="/" aria-label="Ayush Rameja, home"><svg viewBox="0 0 105 50" aria-hidden="true">{heroTiles.map(d => <path d={d} fill-rule="evenodd" />)}</svg></a>
    <p class="hero-location">Bengaluru, <span class="country-full">India</span><span class="country-short">IN</span></p>
  </header>
  <div class="hero-center" id="hero-copy">
    <div class="hero-visual">
      <div class="marquee-window" aria-hidden="true"><div class="marquee-track"><span>Built from curiosity. Built from curiosity.&nbsp;</span><span>Built from curiosity. Built from curiosity.&nbsp;</span></div></div>
      <Image class="hero-portrait" src={portrait} alt="Portrait of Ayush Rameja" widths={[208, 320, 416, 640, 960]} sizes="(max-width: 600px) 208px, 320px" width={320} height={400} format="webp" quality={90} loading="eager" fetchpriority="high" />
    </div>
    <h1 id="hero-title">Ayush Rameja</h1>
    <div class="hero-description"><p>I turn ideas into useful things.</p><p class="supporting">And follow the ideas <br class="mobile-break" />that won’t sit still.</p></div>
    <a class="work-link" href="/projects/">Explore my work <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14 14 2M2 2h12v12" /></svg></a>
  </div>
  <footer class="hero-footer">
    <p class="hero-identity">Built from curiosity.</p>
    <nav class="hero-actions" aria-label="Quick navigation">
      <a class="resume-link" href={resume} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)">Resume <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14 14 2M2 2h12v12" /></svg></a>
      <button class="menu-toggle" type="button" popovertarget="hero-menu" aria-controls="hero-menu" aria-expanded="false" aria-label="Open navigation menu">
        <span class="menu-label">Menu</span><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h20M2 12h20M2 18h14" /></svg>
        <svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5" /></svg>
      </button>
    </nav>
  </footer>
  <nav id="hero-menu" class="hero-menu" popover aria-label="Main navigation">
    <p class="menu-heading">Explore</p>
    {links.map((link, index) => <a href={link.href} target={link.label === "Resume" ? "_blank" : undefined} rel={link.label === "Resume" ? "noopener noreferrer" : undefined} aria-label={link.label === "Resume" ? "Resume (opens in a new tab)" : undefined}><span class="menu-number">0{index + 1}</span><span>{link.label}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14 14 2M2 2h12v12" /></svg></a>)}
    <button type="button" id="hero-motion" aria-pressed="false">Pause background motion</button>
  </nav>
</section></div>
<script>
  import { startHeroPalette } from "../scripts/hero-palette";
  const clock = document.querySelector<HTMLTimeElement>("#hero-clock");
  const day = document.querySelector("#clock-day");
  const time = document.querySelector("#clock-time");
  const clockFormat = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", hour12: true });
  const dayFormat = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Kolkata", weekday: "short" });
  function updateClock() {
    const now = new Date();
    if (clock) clock.dateTime = now.toISOString();
    if (day) day.textContent = `${dayFormat.format(now)} · `;
    if (time) time.textContent = clockFormat.format(now);
  }
  updateClock();
  window.setInterval(updateClock, 30_000);
  const menu = document.querySelector<HTMLElement>("#hero-menu");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  menu?.addEventListener("toggle", () => {
    const open = menu.matches(":popover-open");
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    const label = toggle?.querySelector(".menu-label");
    if (label) label.textContent = open ? "Close" : "Menu";
    if (open) positionMenu();
    else if (menu.contains(document.activeElement)) toggle?.focus();
    if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
  });
  function positionMenu() {
    if (!menu || !toggle || !menu.matches(":popover-open")) return;
    const trigger = toggle.getBoundingClientRect();
    const mobile = window.innerWidth <= 600;
    const left = mobile ? (window.innerWidth-menu.offsetWidth)/2 : trigger.right-menu.offsetWidth;
    menu.style.left = `${Math.max(12, Math.min(left, window.innerWidth-menu.offsetWidth-12))}px`;
    menu.style.top = `${Math.max(12, trigger.top-menu.offsetHeight-20)}px`;
  }
  window.addEventListener("resize", positionMenu);
  window.addEventListener("scroll", positionMenu, { passive: true });
  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero) startHeroPalette(hero);
  const motion = document.querySelector<HTMLButtonElement>("#hero-motion");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  function reflectMotion() {
    if (!motion) return;
    const paused = hero?.classList.contains("motion-paused") ?? false;
    motion.disabled = reduced.matches;
    motion.setAttribute("aria-pressed", String(paused || reduced.matches));
    motion.textContent = reduced.matches ? "Reduced motion enabled" : paused ? "Play background motion" : "Pause background motion";
  }
  motion?.addEventListener("click", () => { hero?.classList.toggle("motion-paused"); reflectMotion(); });
  reduced.addEventListener("change", reflectMotion);
  reflectMotion();
</script>
<style>
  @font-face { font-family: "Inter Tight"; src: url("/fonts/inter-tight-latin.ttf") format("truetype"); font-weight: 400; font-display: swap; }
  .hero-frame { padding: 20px; background: #171a18; }
  .hero { --intro-radius:64px; --hero-top:#c6d0a6; --hero-bottom:#a9cec4; --hero-ink:#2b433b; --hero-muted:#52695f; --hero-accent:#416657; --hero-secondary:#d0ded5; --hero-line:#a9bfb3; --hero-marquee:#7b9688; --hero-paper:#f5f5ef; --focus:#243e48; position:relative; isolation:isolate; display:grid; grid-template-rows:48px 1fr 60px; gap:32px; min-height:max(860px,calc(100svh - 40px)); padding:28px 44px 36px; border-radius:64px; overflow:clip; background:linear-gradient(168deg,var(--hero-top),var(--hero-bottom)); color:var(--hero-ink); font:400 18px/1.4 "Inter Tight",sans-serif; }
  .hero::before { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:url('/brand/hero-grain.svg'); border-radius:inherit; }
  .hero a { color:inherit; text-decoration:none; }
  .hero-header { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:16px; }
  .hero-clock,.hero-location { color:var(--hero-muted); font-size:18px; white-space:nowrap; }
  .hero-clock { font-variant-numeric:tabular-nums; }
  .hero-location { text-align:right; }
  .hero-logo { width:96px; }
  .hero .hero-logo svg { width:100%; height:auto; fill:#416657; stroke:none; display:block; }
  .country-short,.mobile-break,.menu-label { display:none; }
  .hero-center { align-self:center; display:flex; flex-direction:column; align-items:center; width:100%; padding:12px 0; }
  .hero-visual { position:relative; display:grid; place-items:center; width:100%; height:380px; }
  .hero-portrait { position:relative; z-index:1; display:block; width:320px; height:380px; object-fit:cover; object-position:center top; }
  .marquee-window { position:absolute; top:43%; left:-44px; width:calc(100% + 88px); transform:translateY(-50%); overflow:hidden; pointer-events:none; }
  .marquee-track { display:flex; width:max-content; margin-left:-110px; font-size:clamp(100px,12.222vw,200px); line-height:1.1; letter-spacing:-.035em; white-space:nowrap; animation:drift 60s linear infinite; color:var(--hero-marquee); }
  .motion-paused .marquee-track { animation-play-state:paused; }
  @keyframes drift { to { transform:translateX(-50%); } }
  #hero-title { margin:24px 0 0; font-size:32px; font-weight:400; line-height:1.3; letter-spacing:-.025em; }
  .hero-description { margin-top:16px; text-align:center; font-size:22px; line-height:1.4; }
  .hero-description .supporting { color:var(--hero-muted); }
  .work-link { display:flex; align-items:center; justify-content:center; gap:28px; min-height:52px; min-width:248px; margin-top:24px; padding:14px 24px; background:var(--hero-accent); color:var(--hero-paper) !important; border-radius:5px; }
  .hero svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.5; }
  .hero-footer { display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .hero-identity { color:var(--hero-muted); font-size:18px; }
  .hero-actions { display:flex; gap:24px; }
  .resume-link { display:flex; align-items:center; justify-content:space-between; gap:24px; min-width:176px; height:60px; padding:0 24px; }
  .resume-link,.menu-toggle { border:1px solid var(--hero-line); border-radius:8px; background:var(--hero-secondary); color:var(--hero-ink); }
  .resume-link svg,.menu-toggle svg { color:var(--hero-accent); }
  .menu-toggle { display:flex; justify-content:center; align-items:center; gap:20px; width:60px; height:60px; cursor:pointer; }
  .menu-toggle svg { width:24px; height:24px; stroke-width:2; }
  .menu-toggle .close-icon { display:none; }
  .menu-toggle[aria-expanded="true"] .menu-icon { display:none; }
  .menu-toggle[aria-expanded="true"] .close-icon { display:block; }
  .hero-menu { position:fixed; inset:auto; width:360px; max-width:calc(100vw - 48px); max-height:calc(100svh - 140px); overflow-y:auto; margin:0; padding:24px; border:1px solid color-mix(in srgb,var(--hero-line),white 45%); border-radius:20px; background:color-mix(in srgb,var(--hero-paper),white 78%); color:var(--hero-ink); box-shadow:0 12px 36px #203b3512; font:400 18px/1.4 "Inter Tight",sans-serif; }
  .hero-menu::backdrop { background:#203b351a; }
  .menu-heading { padding-bottom:18px; border-bottom:1px solid var(--hero-line); color:var(--hero-muted); font-size:12px; text-transform:uppercase; }
  .hero-menu a { display:grid; grid-template-columns:22px 1fr 16px; align-items:center; gap:12px; min-height:54px; font-size:22px; }
  .menu-number { color:var(--hero-muted); font-size:12px; }
  .hero-menu a svg { color:var(--hero-accent); }
  #hero-motion { width:100%; min-height:44px; margin-top:8px; padding-top:12px; border-top:1px solid var(--hero-line); text-align:left; font-size:13px; color:var(--hero-muted); cursor:pointer; }
  @media(hover:hover) { .work-link:hover { filter:brightness(1.08); } .resume-link:hover,.menu-toggle:hover { background:color-mix(in srgb,var(--hero-secondary),white 45%); } .hero-menu a:hover { color:var(--hero-accent); } }
  @media(max-width:900px) { .hero { padding-inline:28px; } .marquee-window { left:-28px; width:calc(100% + 56px); } }
  @media(max-width:600px) {
    .hero-frame { padding:10px; }
    .hero { --intro-radius:36px; min-height:max(824px,calc(100svh - 20px)); border-radius:36px; padding:24px 20px max(36px,env(safe-area-inset-bottom)); grid-template-rows:40px 1fr 56px; gap:24px; font-size:16px; }
    .hero-header { gap:8px; }
    .hero-clock,.hero-location { font-size:14px; }
    .clock-day,.country-full,.hero-identity,.resume-link { display:none; }
    .country-short,.mobile-break,.menu-label { display:inline; }
    .hero-logo { width:72px; }
    .hero-center { align-self:start; padding:0; margin-top:32px; }
    .hero-visual { height:280px; }
    .hero-portrait { width:208px; height:280px; }
    .marquee-window { left:-20px; width:calc(100% + 40px); top:47%; }
    .marquee-track { font-size:92px; animation-duration:50s; }
    #hero-title { margin-top:24px; font-size:26px; }
    .hero-description { margin-top:24px; font-size:17px; line-height:1.5; }
    .work-link { min-width:216px; gap:26px; margin-top:36px; }
    .hero-footer { justify-content:center; }
    .menu-toggle { width:136px; height:56px; }
    .hero-menu { width:326px; }
  }
  @media(max-width:359px) { .hero-clock,.hero-location { font-size:12px; } .hero-logo { width:60px; } .hero { padding-inline:16px; } .marquee-window { left:-16px; width:calc(100% + 32px); } }
  @media(prefers-reduced-motion:reduce) { .marquee-track { animation:none; } }
</style>
