---
import { Image } from "astro:assets";
import PageTurnIntro from "./PageTurnIntro.astro";
import { heroTiles } from "../brand/hero-tiles";
import { markTones } from "../brand/monogram";
import portrait from "../assets/portrait-approved.png";
import { contact } from "../data/contact";
const resume = contact.resume;
const arrowPath = "M2 8h12M8 2l6 6-6 6";
const links = [
  { label: "Work", href: "/projects/" },
  { label: "Experience", href: "#experience" },
  { label: "Notes", href: "/notes/" },
  { label: "Resume", href: resume },
  { label: "Contact", href: "#contact" },
];
---
<div class="hero-frame" id="home" data-nav-section="Introduction" tabindex="-1"><PageTurnIntro /><section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"><i></i><i></i></div>
  <header class="hero-header">
    <time id="hero-clock" class="hero-clock" ><span class="sr-only">Local time in Bengaluru: </span><span class="clock-day" id="clock-day"></span><span id="clock-time">India · IST</span></time>
    <a class="hero-logo" href="/" aria-label="Ayush Rameja, home"><svg viewBox="0 0 105 50" aria-hidden="true"><defs>{markTones.map(([tone, blend], i) => <linearGradient id={`mark-tone-${i}`} x2="1" y2="1"><stop offset="0" style={`stop-color:color-mix(in oklab,var(--hero-${tone}),white 30%)`} /><stop offset=".45" style={`stop-color:var(--hero-${tone})`} /><stop offset="1" style={`stop-color:color-mix(in oklab,var(--hero-${tone}),var(--hero-${blend}) 60%)`} /></linearGradient>)}</defs>{heroTiles.map((d, i) => <path d={d} fill={`url(#mark-tone-${i % 4})`} fill-rule="evenodd" />)}</svg></a>
    <p class="hero-location">Bengaluru, <span class="country-full">India</span><span class="country-short">IN</span></p>
  </header>
  <div class="hero-center" id="hero-copy">
    <div class="hero-visual">
      <div class="marquee-window" aria-hidden="true"><div class="marquee-track"><span>Built from curiosity. Built from curiosity.&nbsp;</span><span>Built from curiosity. Built from curiosity.&nbsp;</span></div></div>
      <div class="hero-mosaic">
        <i class="tile tile-violet" aria-hidden="true"></i>
        <i class="tile tile-lime" aria-hidden="true"></i>
        <span class="hero-portrait"><Image class="hero-photo" src={portrait} alt="Portrait of Ayush Rameja" widths={[208, 320, 416, 640, 960]} sizes="(max-width: 600px) 190px, 360px" width={320} height={400} format="webp" quality={90} loading="eager" fetchpriority="high" /></span>
        <i class="tile tile-sky" aria-hidden="true"></i>
        <i class="tile tile-coral" aria-hidden="true"></i>
      </div>
    </div>
    <h1 id="hero-title" class="hero-title">Ayush Rameja</h1>
    <div class="hero-description"><p>Full-stack engineer building useful digital products.</p><p class="supporting">Built with care. Driven by curiosity.</p></div>
    <a class="work-link" href="#selected-work"><span class="work-eyes" aria-hidden="true">{[0, 1].map(() => <i class="eye"><span class="eye-ball"><span class="eye-iris"></span><span class="eye-lid"></span></span></i>)}</span><span class="work-face">Explore my work <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} /></svg></span></a>
  </div>
  <footer class="hero-footer">
    <p class="hero-identity">Thoughtful interfaces. Working software.</p>
    <nav class="hero-actions" aria-label="Quick navigation">
      <a class="resume-link" href={resume} target="_blank" rel="noopener noreferrer" aria-label="Resume (opens in a new tab)">Resume <svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} transform="rotate(-45 8 8)" /></svg></a>
      <button class="menu-toggle" type="button" popovertarget="hero-menu" aria-controls="hero-menu" aria-expanded="false" aria-label="Open navigation menu">
        <span class="menu-label">Menu</span><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h20M2 12h20M2 18h14" /></svg>
        <svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5" /></svg>
      </button>
    </nav>
  </footer>
  <nav id="hero-menu" class="hero-menu" popover aria-label="Main navigation">
    <p class="menu-heading">Explore</p>
    {links.map((link, index) => <a href={link.href} target={link.label === "Resume" ? "_blank" : undefined} rel={link.label === "Resume" ? "noopener noreferrer" : undefined} aria-label={link.label === "Resume" ? "Resume (opens in a new tab)" : undefined}><span class="menu-number">0{index + 1}</span><span>{link.label}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d={arrowPath} transform={link.label === "Resume" ? "rotate(-45 8 8)" : undefined} /></svg></a>)}
  </nav>
</section></div>
<script>
  import { setupHeroMotion } from "../scripts/hero-motion";
  import { setupButtonEyes } from "../scripts/button-eyes";
  import { setupMenuMotion } from "../scripts/menu-motion";
  import { createPageScope } from "../scripts/page-scope";
  function setupHero() {
    if (!document.querySelector(".hero")) return;
    const scope = createPageScope();
    const workButton = document.querySelector<HTMLAnchorElement>(".work-link");
    if (workButton) setupButtonEyes(workButton);

    const clock = document.querySelector<HTMLTimeElement>("#hero-clock");
    const day = document.querySelector("#clock-day");
    const time = document.querySelector("#clock-time");
    const clockFormat = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Kolkata", hour: "numeric", minute: "2-digit", hour12: true });
    const dayFormat = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Kolkata", weekday: "short" });
    function updateClock() {
      const now = new Date();
      if (clock) clock.dateTime = now.toISOString();
      if (day) day.textContent = `${dayFormat.format(now)} · `;
      if (time) time.textContent = clockFormat.format(now);
    }
    updateClock();

    const menu = document.querySelector<HTMLElement>("#hero-menu");
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menuMotion = menu ? setupMenuMotion(menu) : undefined;
    scope.listen(menu, "beforetoggle", event => {
      if (!menu) return;
      if ((event as ToggleEvent).newState === "closed" && menu.contains(document.activeElement)) {
        toggle?.focus({ preventScroll: true });
      }
    });
    // In-page links leave the popover open unless it is closed by hand.
    scope.listen(menu, "click", event => {
      if (event.target instanceof Element && event.target.closest("a")) menu?.hidePopover();
    });
    scope.listen(menu, "toggle", () => {
      if (!menu) return;
      const open = menu.matches(":popover-open");
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      const label = toggle?.querySelector(".menu-label");
      if (label) label.textContent = open ? "Close" : "Menu";
      if (open) { positionMenu(); menuMotion?.enter(); }
      else if (menu.contains(document.activeElement)) toggle?.focus();
      if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
    });
    function positionMenu() {
      if (!menu || !toggle || !menu.matches(":popover-open")) return;
      const trigger = toggle.getBoundingClientRect();
      const mobile = window.innerWidth <= 600;
      const left = mobile ? (window.innerWidth-menu.offsetWidth)/2 : trigger.right-menu.offsetWidth;
      menu.style.left = `${Math.max(12, Math.min(left, window.innerWidth-menu.offsetWidth-12))}px`;
      menu.style.top = `${Math.max(12, trigger.top-menu.offsetHeight-20)}px`;
    }
    scope.listen(window, "resize", positionMenu);
    scope.listen(window, "scroll", positionMenu, { passive: true });
    const hero = document.querySelector<HTMLElement>(".hero");
    if (hero) setupHeroMotion(hero);

    const reflectVisibility = () => hero?.classList.toggle("page-hidden", document.hidden);
    scope.listen(document, "visibilitychange", reflectVisibility);
    reflectVisibility();
  }
  setupHero();
</script>

<style>
  .hero-frame { position: relative; padding: 20px; }
  .hero { --intro-radius:64px; --focus:var(--hero-ink); color-scheme:dark; position:relative; isolation:isolate; display:grid; grid-template-rows:48px 1fr auto; gap:24px; min-height:calc(100svh - 40px); padding:24px 44px 28px; border-radius:64px; overflow:clip; background:linear-gradient(168deg,var(--hero-top),var(--hero-bottom)); color:var(--hero-ink); font:400 18px/1.4 var(--font-ui); }
  .hero a { color:inherit; text-decoration:none; }
  .hero-header { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:16px; }
  .hero-clock,.hero-location { color:var(--hero-muted); font-size:18px; white-space:nowrap; }
  .hero-clock { font-variant-numeric:tabular-nums; }
  .hero-location { text-align:right; }
  .hero-logo { width:96px; }
  .hero .hero-logo svg { width:100%; height:auto; stroke:none; display:block; }
  .country-short { display:none; }
  /* Soft light from the panel's edges; a second arrangement fades in and out
     so the colours appear to travel. Grain keeps the surface matte. */
  .hero-glow { position:absolute; inset:0; z-index:-1; overflow:hidden; pointer-events:none; }
  .hero-glow i { position:absolute; inset:0; background:radial-gradient(ellipse 30% 64% at 0% 62%,var(--glow-a),transparent 72%),radial-gradient(ellipse 54% 36% at 30% 100%,var(--glow-b),transparent 72%),radial-gradient(ellipse 30% 64% at 100% 38%,var(--glow-c),transparent 72%),radial-gradient(ellipse 54% 36% at 70% 0%,var(--glow-d),transparent 72%); }
  .hero-glow i:first-child { --glow-a:var(--hero-glow-violet); --glow-b:var(--hero-glow-coral); --glow-c:var(--hero-glow-sky); --glow-d:var(--hero-glow-lime); }
  .hero-glow i:last-child { --glow-a:var(--hero-glow-sky); --glow-b:var(--hero-glow-violet); --glow-c:var(--hero-glow-lime); --glow-d:var(--hero-glow-coral); opacity:0; animation:glow-shift 9s ease-in-out infinite alternate; }
  .hero-glow::after { content:""; position:absolute; inset:0; background:var(--hero-grain-light,none); opacity:.2; }
  .motion-paused .hero-glow i { animation-play-state:paused; }
  @keyframes glow-shift { to { opacity:1; } }
  .hero-center { container-type:inline-size; align-self:center; display:flex; flex-direction:column; align-items:center; width:100%; padding:12px 0; }
  .hero-visual { position:relative; display:grid; grid-template-columns:minmax(0,1fr); place-items:center; width:100%; }
  /* The mosaic borrows the mark's tiles: four quarter discs close around the
     portrait into one rounded shape. */
  .hero-mosaic { --cell:clamp(72px,min(calc((100cqi - 30px)/4),17svh),176px); position:relative; z-index:1; display:grid; grid-template-columns:repeat(4,var(--cell)); grid-template-rows:repeat(2,var(--cell)); gap:10px; }
  .tile { display:block; background:var(--hero-grain,none),linear-gradient(145deg,color-mix(in oklab,var(--tone),white 16%),var(--tone) 42%,color-mix(in oklab,var(--tone),var(--blend) 40%)); background-blend-mode:overlay,normal; box-shadow:inset 0 2px 4px rgb(255 255 255/.22),inset 0 -14px 28px rgb(0 0 0/.14); transition:rotate 700ms cubic-bezier(.22,1,.36,1); }
  .tile-violet { --tone:var(--hero-violet); --blend:var(--hero-coral); grid-area:1/1; border-radius:100% 12px 12px 12px; }
  .tile-lime { --tone:var(--hero-lime); --blend:var(--hero-sky); grid-area:2/1; border-radius:12px 12px 12px 100%; }
  .tile-sky { --tone:var(--hero-sky); --blend:var(--hero-violet); grid-area:1/4; border-radius:12px 100% 12px 12px; }
  .tile-coral { --tone:var(--hero-coral); --blend:var(--hero-lime); grid-area:2/4; border-radius:12px 12px 100% 12px; }
  .hero-portrait { grid-area:1/2/3/4; display:block; overflow:hidden; border-radius:28px; }
  .hero-photo { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; }
  .marquee-window { position:absolute; top:50%; left:-44px; width:calc(100% + 88px); transform:translateY(-50%); overflow:hidden; pointer-events:none; }
  .marquee-track { display:flex; width:max-content; margin-left:-110px; font-size:clamp(100px,12.222vw,200px); line-height:1.1; letter-spacing:-.035em; white-space:nowrap; animation:drift 60s linear infinite; color:transparent; background:linear-gradient(90deg,var(--hero-violet),var(--hero-sky),var(--hero-lime),var(--hero-coral),var(--hero-violet)) 0 0/50% 100%; -webkit-background-clip:text; background-clip:text; opacity:.17; }
  .motion-paused .marquee-track { animation-play-state:paused; }
  @keyframes drift { to { transform:translateX(-50%); } }
  .hero-title { margin:28px 0 0; font-size:clamp(40px,4.4vw,64px); font-weight:500; line-height:1.1; letter-spacing:-.03em; }
  .hero-description { margin-top:14px; max-width:560px; text-align:center; font-size:20px; line-height:1.4; }
  .hero-description .supporting { color:var(--hero-muted); }
  .hero .work-link { position:relative; isolation:isolate; display:flex; min-height:52px; min-width:248px; margin-top:32px; border:0; color:var(--color-paper); border-radius:14px; font-weight:500; }
  /* The body the eyes live in only shows once the face lifts. */
  /* The body under the lifted face is the face's own lime and sky in shadow, so the button reads as one object. */
  .work-link::before { content:""; position:absolute; inset:0; border-radius:inherit; background:var(--hero-grain,none),linear-gradient(120deg,color-mix(in oklab,var(--hero-accent),black 52%),color-mix(in oklab,color-mix(in oklab,var(--hero-accent),var(--hero-sky) 40%),black 50%)); background-blend-mode:overlay,normal; opacity:0; transition:opacity 160ms; }
  .work-link.eyes-active::before { opacity:1; }
  /* Set the face's foreground directly; links/visited states must not recolor it. */
  .work-face { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; gap:12px; width:100%; min-height:52px; padding:13px 23px; border:0; border-radius:inherit; background:var(--hero-grain,none),linear-gradient(120deg,var(--hero-accent),color-mix(in oklab,var(--hero-accent),var(--hero-sky) 26%)); background-blend-mode:overlay,normal; color:var(--hero-paper); -webkit-text-fill-color:currentColor; transform-origin:50% 50%; transition:transform 400ms cubic-bezier(.22,1,.36,1); }
  .work-face svg { color:inherit; }
  .work-eyes { position:absolute; left:50%; bottom:4px; display:flex; gap:5px; opacity:0; transform:translateX(calc(-50% + var(--eye-drift-x,0px))) translateY(var(--eye-drift-y,0px)); transition:transform 850ms cubic-bezier(.22,1,.36,1),opacity 180ms; }
  .eye { position:relative; display:block; width:16px; height:15px; transition:transform 260ms cubic-bezier(.34,1.56,.64,1); }
  .eye::before { content:""; position:absolute; left:-1px; top:-6px; width:18px; height:5px; border-top:2px solid var(--color-paper); border-radius:70% 60% 0 0; transform:rotate(-9deg); transition:transform 260ms cubic-bezier(.34,1.56,.64,1); }
  .eye:last-child::before { transform:translateY(-1px) rotate(12deg); }
  /* Eyeball, iris with pupil, a fixed glint, and an upper lid that does the blinking. */
  .eye-ball { position:relative; display:block; width:100%; height:100%; overflow:hidden; border-radius:50% 50% 46% 46%; background:radial-gradient(circle at 50% 38%,#fff,#ece7dd 68%,#cdc5b6); box-shadow:inset 0 2px 2px rgb(24 12 70/.3); }
  .eye-ball::after { content:""; position:absolute; z-index:1; left:27%; top:20%; width:3px; height:3px; border-radius:50%; background:#fff; }
  .eye-iris { position:absolute; left:50%; top:52%; width:9px; height:9px; border-radius:50%; background:radial-gradient(circle,#09090b 0 33%,#9a6a2f 37% 60%,#4a2c12 65%); transform:translate(-50%,-50%) translate(var(--look-x,0px),var(--look-y,0px)) scale(var(--pupil,1)); transition:transform 120ms ease-out; }
  .eye-lid { position:absolute; z-index:2; inset:-1px; background:color-mix(in oklab,var(--hero-violet),white 16%); border-bottom:1.5px solid #2a1a66; transform:translateY(calc((var(--lid,0) - 1)*100%)); transition:transform 140ms ease-in; }
  .eyes-curious .eye:first-child::before { transform:translateY(-3px) rotate(-17deg); }
  .eyes-curious .eye:last-child { transform:translateY(1px); }
  .eyes-surprised .work-eyes { --pupil:.62; }
  .eyes-surprised .eye { transform:scale(1.22); }
  .eyes-surprised .eye::before,.eyes-surprised .eye:last-child::before { transform:translateY(-4px); }
  .eyes-shifty .work-eyes { --lid:.42; }
  .eyes-shifty .eye::before,.eyes-shifty .eye:last-child::before { transform:translateY(2px); }
  .eyes-sleepy .work-eyes { --lid:.58; }
  .eyes-asleep .work-eyes { --lid:1; }
  .eyes-sleepy .eye-lid,.eyes-asleep .eye-lid { transition-duration:700ms; }
  .eyes-sleepy .eye::before,.eyes-asleep .eye::before { transform:translateY(1px) rotate(5deg); }
  .eyes-sleepy .eye:last-child::before,.eyes-asleep .eye:last-child::before { transform:translateY(1px) rotate(-5deg); }
  .eyes-dizzy .work-eyes { --lid:.16; }
  .eyes-dizzy .eye-iris { transition:none; }
  .eyes-dizzy .eye:first-child::before { transform:translateY(-2px) rotate(14deg); }
  .work-link.eyes-active .work-eyes { opacity:1; }
  .work-link.eyes-active .work-face { transform:translateY(-22px) rotate(var(--eye-lean,-2deg)); }
  .work-link.eyes-surprised .work-face { transform:translateY(-27px) rotate(var(--eye-lean,-2deg)); }
  .hero svg { width:16px; height:16px; flex-shrink:0; fill:none; stroke:currentColor; stroke-width:1.5; }
  .hero-footer { display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .hero-identity { color:var(--hero-muted); font-size:18px; }
  .hero-actions { display:flex; gap:5px; }
  .resume-link { position:relative; isolation:isolate; overflow:hidden; transition:color 222ms ease; display:flex; align-items:center; justify-content:space-between; gap:24px; min-width:176px; height:60px; padding:0 24px; }
  .resume-link,.menu-toggle { border:1px solid var(--hero-line); border-radius:14px; background:#16161a; color:var(--hero-ink); }
  .resume-link svg,.menu-toggle svg { color:var(--hero-accent); }
  .menu-toggle { position:relative; isolation:isolate; overflow:hidden; transition:color 222ms ease; display:flex; justify-content:center; align-items:center; gap:20px; width:60px; height:60px; cursor:pointer; }
  .resume-link::before,.menu-toggle::before { content:""; position:absolute; inset:0; z-index:-1; background:var(--hero-grain,none),linear-gradient(120deg,var(--hero-accent),color-mix(in oklab,var(--hero-accent),var(--hero-sky) 26%)); background-blend-mode:overlay,normal; transform:translateY(101%); transition:transform 333ms cubic-bezier(.22,1,.36,1); }
  .resume-link:focus-visible::before,.menu-toggle:focus-visible::before { transform:translateY(0); }
  .hero .resume-link:focus-visible,.resume-link:focus-visible svg,.menu-toggle:focus-visible,.menu-toggle:focus-visible svg { color:var(--hero-paper); }
  .menu-toggle svg { width:24px; height:24px; stroke-width:2; }
  .menu-toggle .close-icon { display:none; }
  .menu-toggle[aria-expanded="true"] .menu-icon { display:none; }
  .menu-toggle[aria-expanded="true"] .close-icon { display:block; }
  .hero-menu { position:fixed; inset:auto; width:360px; max-width:calc(100vw - 48px); max-height:calc(100svh - 140px); overflow-y:auto; margin:0; padding:24px; border:1px solid var(--hero-line); border-radius:28px; background:#141418; color:var(--hero-ink); box-shadow:0 16px 48px #0008; font:400 18px/1.4 var(--font-ui); }
  .hero-menu::backdrop { background:#0008; }
  .menu-heading { margin:0 0 12px; padding:0 10px 16px; border-bottom:1px solid var(--hero-line); color:var(--hero-muted); font-size:var(--text-caption); text-transform:none; }
  .hero-menu a { --row:var(--hero-violet); position:relative; isolation:isolate; overflow:hidden; border-radius:12px; padding:12px; transition:color 222ms ease; display:grid; grid-template-columns:22px 1fr 16px; align-items:center; gap:12px; min-height:54px; font-size:22px; }
  .hero-menu a:nth-of-type(4n+2) { --row:var(--hero-lime); }
  .hero-menu a:nth-of-type(4n+3) { --row:var(--hero-coral); }
  .hero-menu a:nth-of-type(4n) { --row:var(--hero-sky); }
  .hero-menu a + a { margin-top:6px; }
  .hero-menu a::before { content:""; position:absolute; inset:0; z-index:-1; background:var(--row); transform:scaleX(0); transform-origin:left; transition:transform 356ms cubic-bezier(.22,1,.36,1); }
  .hero-menu a:focus-visible::before { transform:scaleX(1); }
  .hero-menu a:focus-visible,.hero-menu a:focus-visible .menu-number,.hero-menu a:focus-visible svg { color:var(--hero-paper); }
  .hero-menu[data-exit-copy] a::before { display:none; }
  .menu-number { color:var(--hero-muted); font-size:var(--text-caption); }
  .hero-menu a svg { color:var(--row); }
  .menu-label { display:none; }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  @media(hover:hover) {
    .tile:hover { rotate:90deg; }
    .resume-link:hover::before,.menu-toggle:hover::before { transform:translateY(0); }
    .hero .resume-link:hover,.resume-link:hover svg,.menu-toggle:hover,.menu-toggle:hover svg { color:var(--hero-paper); }
    .hero-menu a:hover::before { transform:scaleX(1); }
    .hero-menu a:hover,.hero-menu a:hover .menu-number,.hero-menu a:hover svg { color:var(--hero-paper); }
  }
  @media(max-width:900px) { .hero { padding-inline:28px; } .marquee-window { left:-28px; width:calc(100% + 56px); } }
  @media(max-width:600px) {
    .hero-frame { padding:10px; }
    .hero { --intro-radius:36px; min-height:calc(100svh - 20px); border-radius:36px; padding:20px 20px max(20px,env(safe-area-inset-bottom)); grid-template-rows:40px 1fr auto; gap:20px; font-size:16px; }
    .hero-header { gap:8px; }
    .hero-clock,.hero-location { font-size:14px; }
    .clock-day,.country-full,.hero-identity { display:none; }
    .country-short { display:inline; }
    .hero-logo { width:72px; }
    .hero-center { padding:0; }
    /* The discs run out to the panel's edges. */
    .hero-mosaic { --cell:min(calc((100cqi + 10px)/4),13svh); }
    .hero-portrait { border-radius:20px; }
    .marquee-window { display:none; }
    .hero-title { margin-top:24px; font-size:36px; }
    .hero-description { margin-top:12px; font-size:17px; line-height:1.5; }
    .hero .work-link { min-width:216px; margin-top:28px; }
    .hero-footer { flex-wrap:wrap; justify-content:center; gap:8px 20px; }
    .hero-actions { gap:12px; }
    .resume-link { display:none; }
    .menu-label { display:inline; }
    .menu-toggle { width:136px; height:52px; }
